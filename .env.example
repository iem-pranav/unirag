# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=

# Admin DB user: owns tables, loads data. Used by docker compose.
POSTGRES_USER=unirag_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=unirag

# Read-only DB user for the app. Password must match DATABASE_URL.
UNIRAG_RO_PASSWORD=change_me
DATABASE_URL=postgresql://unirag_ro:change_me@localhost:5432/unirag
